{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alivera-atelier",
  "main": "src/index.js",
  "compatibility_date": "2026-03-01",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alivera-atelier-db",
      "database_id": "YOUR_DATABASE_ID"
    }
  ]
}
